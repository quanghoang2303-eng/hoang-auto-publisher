# Change to the actual path on your MacBook.
VIDEO_DIR=/Users/YOUR_NAME/Videos/AutoPublisher/inbox
TIMEZONE=Asia/Ho_Chi_Minh
POST_TIMES=09:00,12:00,18:00
MAX_DAILY_POSTS=3
# Full-length episodes: upload to YouTube and Facebook independently.
# Leave FULL_VIDEO_DIR empty and YT_LONG_VIDEO_DIR empty to disable full episodes.
FULL_VIDEO_DIR=
FULL_PLATFORMS=facebook,youtube
FULL_POST_TIMES=19:00
FULL_POST_DAYS=mon,wed,fri
FULL_MAX_DAILY_POSTS=1
# Old V2 variables still supported (only used if FULL_* equivalent is unset).
# For weekly uploads, use e.g. mon,wed,fri. Blank days = all 7 days.
YT_LONG_VIDEO_DIR=
YT_LONG_POST_TIMES=19:00
YT_LONG_POST_DAYS=mon,wed,fri
YT_LONG_MAX_DAILY_POSTS=1
MISSED_SLOT_GRACE_MINUTES=25
MIN_FILE_AGE_SECONDS=60
# Add ,tiktok only after selecting and calibrating a TikTok mode.
PLATFORMS=facebook,youtube

# Keep disabled until dry-run and token setup succeed.
ENABLE_LIVE_POSTING=false

# Optional vision-based caption creation (3 keyframes + .txt sidecar).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Meta Page permissions: pages_manage_posts, pages_read_engagement, pages_show_list.
FB_GRAPH_VERSION=v27.0
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=
# Multipart safety limit for the Facebook Page Videos endpoint (1 GB by default).
FB_FULL_MAX_BYTES=1000000000
FB_VIDEO_UPLOAD_HOST=graph.facebook.com

# Download an OAuth Desktop client JSON to client_secret.json; authorize once.
YT_CLIENT_SECRET_FILE=client_secret.json
YT_TOKEN_FILE=token.json
YT_PRIVACY=public
# Can be private during initial long-form testing; public for fully automated release.
YT_LONG_PRIVACY=private
YT_LONG_CATEGORY_ID=27
# Optional content classification, set true/false if appropriate for your channel.
YT_MADE_FOR_KIDS=

# off | api | adb. API mode needs an approved developer app and per-post consent.
TIKTOK_MODE=off
TIKTOK_ACCESS_TOKEN=
TIKTOK_PRIVACY=PUBLIC_TO_EVERYONE
TIKTOK_APP_APPROVED=false
TIKTOK_ADB_SERIAL=
TIKTOK_ADB_STEPS=tiktok_steps.json
ADB_MACRO_APPROVED=false
TIKTOK_PACKAGE=com.zhiliaoapp.musically

# Optional Telegram notifications.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=